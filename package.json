{
  "name": "needle-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Registry and hub of WebMCP tools across Needle web apps — built for 3D web development.",
  "scripts": {
    "dev": "vite dev --host",
    "start": "npm run dev",
    "build": "vite build -- --production",
    "build:production": "npm run build",
    "build:static": "vite build -- --production --static",
    "build:dev": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "troupe": "node tools/troupe.mjs",
    "deploy": "npm run build:static && npx --yes needle-cloud deploy dist --token"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "svelte": "^5.57.0",
    "typescript": "^5.0.4",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  },
  "author": {
    "name": "Needle Tools",
    "email": "hi@needle.tools",
    "url": "https://needle.tools"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/needle-tools/webmcp"
  }
}
