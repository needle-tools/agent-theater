{
  "name": "@needle-tools/gibberish",
  "version": "0.1.0",
  "description": "Browser-based gibberish voice synthesis from text",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/needle-tools/agent-theater.git",
    "directory": "packages/gibberish"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./synth": { "types": "./dist/synth.d.ts", "default": "./dist/synth.js" },
    "./timing": { "types": "./dist/timing.d.ts", "default": "./dist/timing.js" },
    "./phonemes": { "types": "./dist/phonemes.d.ts", "default": "./dist/phonemes.js" },
    "./vowels": { "types": "./dist/vowels.d.ts", "default": "./dist/vowels.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "publishConfig": { "access": "public" }
}
