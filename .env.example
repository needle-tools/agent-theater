# Coolify supplies PORT automatically. The Dockerfile defaults to 3000.
PORT=3000
ORIGIN=https://plays.example.com
# Coolify's trusted reverse proxy supplies the real client address through this
# header. Keep the app unreachable directly, or clients could spoof this value.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# Coolify managed PostgreSQL connection string. Keep this server-only.
DATABASE_URL=postgresql://user:password@postgres:5432/needle_webmcp

# Optional: notify a Discord channel after a new public play is saved.
# Set this secret only on the server (for example in Coolify).
DISCORD_PLAY_WEBHOOK_URL=

# Backblaze B2 S3-compatible API. Create an application key limited to this bucket.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=needle-webmcp-theatre
B2_KEY_ID=
B2_APPLICATION_KEY=

# Public bucket URL, preferably through a Cloudflare custom domain.
PUBLIC_ASSET_BASE_URL=https://assets.example.com

# Publishing asset limits.
MAX_ASSET_BYTES=1048576
MAX_ASSETS_PER_PLAY=40
MAX_PLAY_ASSET_BYTES=12582912

# Optional build/deploy revision stored with newly published documents.
COMMIT_SHA=
